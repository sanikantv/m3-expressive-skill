{
  "name": "m3-expressive-skill-intro",
  "version": "1.0.0",
  "description": "The M3 Expressive Skill intro video (Remotion, ElevenLabs voice)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/fonts": "4.0.538",
    "@remotion/media": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "voiceover": "node --env-file=.env scripts/generate-voiceover.mjs",
    "render": "remotion render Intro out/intro.mp4 --codec=h264 --crf=18 --audio-bitrate=192k && ffmpeg -loglevel error -y -i out/intro.mp4 -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11 -ar 48000 -c:a aac -b:a 192k -movflags +faststart ../art/intro.mp4",
    "poster": "rm -f ../art/intro-poster.jpg && remotion still Poster ../art/intro-poster.jpg --image-format=jpeg --jpeg-quality=90"
  },
  "allowScripts": {
    "esbuild": false
  }
}
