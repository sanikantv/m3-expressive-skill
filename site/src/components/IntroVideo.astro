---
// The 78-second intro video (../art/intro.mp4, copied in by `npm run media`).
---

<figure class="intro-video not-content" id="intro">
  <video
    controls
    preload="none"
    playsinline
    width="1920"
    height="1080"
    poster="/media/intro-poster.jpg"
    aria-label="Intro video: M3 Expressive Skill for Jetpack Compose"
  >
    <source src="/media/intro.mp4" type="video/mp4" />
  </video>
  <figcaption>The skill in 78 seconds. <a href="/media/intro.mp4" download>Download the MP4</a></figcaption>
</figure>

<style>
  .intro-video {
    margin: 2rem 0 0;
  }
  .intro-video video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--md-shape-xl);
    background: var(--md-surface-container);
  }
  .intro-video figcaption {
    margin-top: 0.6rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--md-on-surface-variant);
  }
  .intro-video a {
    color: var(--md-primary);
  }
</style>
