---
// Small HTML/CSS versions of the Expressive components, to show the behaviour the Compose code
// produces (shape morph on press, selection that changes shape, FAB menu, wavy progress …).
// They are illustrations: real metrics and motion come from material3 on Android.
import Icon from './Icon.astro';
import LoadingMorph from './LoadingMorph.astro';

type Kind =
  | 'buttons'
  | 'toggle'
  | 'connected'
  | 'group'
  | 'split'
  | 'icon'
  | 'fab-menu'
  | 'toolbar'
  | 'appbar'
  | 'nav'
  | 'list'
  | 'progress'
  | 'search';

interface Props {
  kind: Kind;
  caption?: string;
}
const { kind, caption } = Astro.props;

// Wavy circular indicator: a sine wave riding a 270° arc.
const wavyArc = (() => {
  const pts: string[] = [];
  for (let i = 0; i <= 180; i++) {
    const a = (-90 + (270 * i) / 180) * (Math.PI / 180);
    const r = 40 + 2.6 * Math.sin(i * 0.95);
    pts.push(`${(50 + r * Math.cos(a)).toFixed(2)} ${(50 + r * Math.sin(a)).toFixed(2)}`);
  }
  return 'M' + pts.join('L');
})();
---

<figure class:list={['demo', `demo-${kind}`, 'not-content']} data-demo={kind}>
  <div class="demo-stage">
    {
      kind === 'buttons' && (
        <div class="d-col">
          <div class="d-row">
            <button type="button" class="md-btn">
              Continue
            </button>
            <button type="button" class="md-btn tonal">
              Later
            </button>
            <button type="button" class="md-btn outlined">
              Cancel
            </button>
          </div>
          <div class="d-row d-sizes" aria-label="Button sizes">
            <button type="button" class="d-size xs">XS 32</button>
            <button type="button" class="d-size s">S 40</button>
            <button type="button" class="d-size m">M 56</button>
            <button type="button" class="d-size l">L 96</button>
          </div>
        </div>
      )
    }
    {
      kind === 'toggle' && (
        <div class="d-row">
          <button type="button" class="d-toggle" aria-pressed="false" data-toggle>
            <Icon name="person_add" size={20} />
            <span class="off">Follow</span>
            <span class="on">Following</span>
          </button>
          <button type="button" class="d-toggle tonal" aria-pressed="true" data-toggle>
            <Icon name="notifications" size={20} />
            Alerts
          </button>
        </div>
      )
    }
    {
      kind === 'connected' && (
        <div class="d-connected" role="radiogroup" aria-label="Period" data-single>
          {['Day', 'Week', 'Month', 'Year'].map((l, i) => (
            <button type="button" role="radio" aria-checked={i === 1 ? 'true' : 'false'}>
              <Icon name="check" size={18} class="d-check" />
              {l}
            </button>
          ))}
        </div>
      )
    }
    {
      kind === 'group' && (
        <div class="d-group" aria-label="Formatting">
          {['format_bold', 'format_italic', 'format_underlined', 'format_strikethrough', 'link'].map((n) => (
            <button type="button" aria-label={n.replace('format_', '').replace('_', ' ')}>
              <Icon name={n} />
            </button>
          ))}
        </div>
      )
    }
    {
      kind === 'split' && (
        <div class="d-split" data-expandable>
          <button type="button" class="d-split-lead">
            <Icon name="send" size={20} />
            Send
          </button>
          <button type="button" class="d-split-trail" aria-expanded="false" aria-label="More send options" data-expand>
            <Icon name="keyboard_arrow_down" />
          </button>
          <ul class="d-menu" role="menu">
            <li role="menuitem">
              <Icon name="schedule_send" size={20} /> Schedule send
            </li>
            <li role="menuitem">
              <Icon name="drafts" size={20} /> Save draft
            </li>
          </ul>
        </div>
      )
    }
    {
      kind === 'icon' && (
        <div class="d-row">
          {[
            ['favorite', 'Favorite'],
            ['bookmark', 'Bookmark'],
            ['volume_up', 'Sound'],
          ].map(([n, l], i) => (
            <button type="button" class="d-icon-toggle" aria-pressed={i === 0 ? 'true' : 'false'} aria-label={l} data-toggle>
              <Icon name={n} />
            </button>
          ))}
        </div>
      )
    }
    {
      kind === 'fab-menu' && (
        <div class="d-fabmenu" data-expandable>
          <ul class="d-fab-items">
            {[
              ['photo_library', 'Add photos'],
              ['share', 'Share album'],
              ['search', 'Search'],
            ].map(([n, l]) => (
              <li>
                <button type="button" tabindex="-1">
                  <Icon name={n} size={22} />
                  {l}
                </button>
              </li>
            ))}
          </ul>
          <button type="button" class="d-fab" aria-expanded="false" aria-label="Toggle menu" data-expand>
            <Icon name="edit" class="i-closed" />
            <Icon name="close" class="i-open" />
          </button>
        </div>
      )
    }
    {
      kind === 'toolbar' && (
        <div class="d-toolbar-wrap" data-expandable>
          <div class="d-toolbar" aria-label="Editor tools">
            {['undo', 'redo', 'format_paint', 'image', 'more_vert'].map((n, i) => (
              <button type="button" aria-label={n.replace('_', ' ')} class:list={{ selected: i === 2 }}>
                <Icon name={n} />
              </button>
            ))}
          </div>
          <button type="button" class="d-toolbar-fab" aria-label="Add">
            <Icon name="add" />
          </button>
          <button type="button" class="md-btn small outlined d-collapse" aria-expanded="true" data-expand>
            <Icon name="unfold_less" /> Collapse
          </button>
        </div>
      )
    }
    {
      kind === 'appbar' && (
        <div class="d-appbar">
          <div class="d-appbar-top">
            <Icon name="arrow_back" />
            <span class="d-spacer" />
            <Icon name="search" />
            <Icon name="more_vert" />
          </div>
          <p class="d-appbar-title">Inbox</p>
          <p class="d-appbar-sub">12 unread · 3 starred</p>
        </div>
      )
    }
    {
      kind === 'nav' && (
        <nav class="d-nav" aria-label="Demo navigation" data-single>
          {[
            ['home', 'Home'],
            ['explore', 'Explore'],
            ['library_music', 'Library'],
            ['person', 'Profile'],
          ].map(([n, l], i) => (
            <button type="button" aria-checked={i === 0 ? 'true' : 'false'} role="radio">
              <span class="d-nav-ind">
                <Icon name={n} />
              </span>
              {l}
            </button>
          ))}
        </nav>
      )
    }
    {
      kind === 'list' && (
        <ul class="d-seglist">
          {[
            ['wifi', 'Wi-Fi', 'Home network', true],
            ['bluetooth', 'Bluetooth', 'Off', false],
            ['dark_mode', 'Dark theme', 'Follows the system', true],
          ].map(([n, t, s, on]) => (
            <li>
              <button type="button" role="switch" aria-checked={on ? 'true' : 'false'} data-toggle-checked>
                <Icon name={n as string} />
                <span class="d-seg-text">
                  <strong>{t}</strong>
                  <span>{s}</span>
                </span>
                <span class="d-switch" aria-hidden="true">
                  <span />
                </span>
              </button>
            </li>
          ))}
        </ul>
      )
    }
    {
      kind === 'progress' && (
        <div class="d-col d-progress">
          <div class="d-linear" role="progressbar" aria-label="Download" aria-valuenow="62" aria-valuemin="0" aria-valuemax="100">
            <span class="d-wave" style="--p: 62%" />
            <span class="d-track" />
          </div>
          <div class="d-row">
            <svg class="d-circ" viewBox="0 0 100 100" width="72" height="72" role="img" aria-label="Wavy circular progress">
              <circle cx="50" cy="50" r="40" class="d-circ-track" />
              <path d={wavyArc} class="d-circ-wave" />
            </svg>
            <LoadingMorph size={56} label="Loading indicator" />
            <LoadingMorph size={72} contained label="Contained loading indicator" />
          </div>
        </div>
      )
    }
    {
      kind === 'search' && (
        <div class="d-search" data-expandable>
          <button type="button" class="d-search-bar" aria-expanded="false" data-expand>
            <Icon name="search" />
            <span>Search messages</span>
            <span class="d-avatar" aria-hidden="true">S</span>
          </button>
          <ul class="d-search-results">
            {['Design review notes', 'Shape morph prototype', 'Spring motion tokens'].map((r) => (
              <li>
                <Icon name="history" size={20} />
                {r}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const toggle = t.closest<HTMLElement>('[data-toggle]');
    if (toggle) toggle.setAttribute('aria-pressed', String(toggle.getAttribute('aria-pressed') !== 'true'));
    const sw = t.closest<HTMLElement>('[data-toggle-checked]');
    if (sw) sw.setAttribute('aria-checked', String(sw.getAttribute('aria-checked') !== 'true'));
    const option = t.closest<HTMLElement>('[data-single] > *');
    if (option) option.parentElement!.querySelectorAll(':scope > *').forEach((o) => o.setAttribute('aria-checked', String(o === option)));
    const expand = t.closest<HTMLElement>('[data-expand]');
    if (expand) expand.setAttribute('aria-expanded', String(expand.getAttribute('aria-expanded') !== 'true'));
  });
</script>
