---
// Shows one `// region <name>` … `// endregion` block from the verify/snippets Gradle module.
// The module is compiled in CI against the pinned material3 version, so every Kotlin sample on
// this site (and in the skill itself) is known to build.
import { Code } from '@astrojs/starlight/components';
import { readFileSync, readdirSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
  region: string;
  title?: string;
}

const { region, title } = Astro.props;
const dir = resolve(process.cwd(), '../verify/snippets/src/main/java/dev/sanikant/m3/skill/snippets');
let code: string | undefined;
for (const file of readdirSync(dir).filter((f) => f.endsWith('.kt'))) {
  const lines = readFileSync(resolve(dir, file), 'utf8').split('\n');
  const start = lines.findIndex((l) => l.trim() === `// region ${region}`);
  if (start < 0) continue;
  const end = lines.findIndex((l, i) => i > start && l.trim() === '// endregion');
  const body = lines.slice(start + 1, end);
  const indent = Math.min(...body.filter((l) => l.trim()).map((l) => l.match(/^ */)![0].length));
  code = body.map((l) => l.slice(indent)).join('\n').trim();
  break;
}
if (!code) throw new Error(`Snippet region "${region}" not found in verify/snippets`);
---

<Code code={code} lang="kotlin" title={title} />
