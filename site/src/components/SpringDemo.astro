---
// Side-by-side MotionScheme springs, played with CSS linear() easings generated from the
// material3 tokens (src/styles/springs.css). Spatial specs move and may overshoot; effects specs
// change color and never do.
import Icon from './Icon.astro';
import shapes from '../data/shapes.json';

const rows = [
  { key: 'expressive-fast-spatial', label: 'Expressive · fast spatial' },
  { key: 'expressive-default-spatial', label: 'Expressive · default spatial' },
  { key: 'standard-default-spatial', label: 'Standard · default spatial' },
  { key: 'default-effects', label: 'Effects · default (color, alpha)' },
] as const;
const springs = shapes.springs as Record<string, { damping: number; stiffness: number; ms: number }>;
---

<div class="spring-demo not-content" data-spring-demo>
  <div class="sd-rows">
    {
      rows.map((r) => {
        const s = springs[r.key];
        return (
          <div class="sd-row" style={`--ease: var(--md-spring-${r.key}); --ms: var(--md-spring-${r.key}-ms)`}>
            <div class="sd-label">
              <strong>{r.label}</strong>
              <span>
                damping {s.damping} · stiffness {s.stiffness}
              </span>
            </div>
            <div class="sd-track">
              <span class:list={['sd-dot', { effects: r.key.includes('effects') }]} />
            </div>
          </div>
        );
      })
    }
  </div>
  <button type="button" class="md-btn small" data-spring-play>
    <Icon name="play_arrow" /> Play
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-spring-demo]').forEach((demo) => {
    demo.querySelector('[data-spring-play]')!.addEventListener('click', () => demo.toggleAttribute('data-on'));
  });
</script>

<style>
  .spring-demo {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    margin-block: 1.5rem;
    border-radius: var(--md-shape-xl);
    background: var(--md-surface-container-low);
  }
  .sd-rows {
    display: grid;
    gap: 0.9rem;
    width: 100%;
  }
  .sd-row {
    display: grid;
    grid-template-columns: minmax(10rem, 15rem) 1fr;
    gap: 1rem;
    align-items: center;
  }
  .sd-label {
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
    line-height: 1.3;
  }
  .sd-label span {
    color: var(--md-on-surface-variant);
    font-size: 0.8rem;
  }
  .sd-track {
    position: relative;
    height: 2.5rem;
    border-radius: var(--md-shape-full);
    background: var(--md-surface-container-highest);
  }
  .sd-dot {
    position: absolute;
    top: 0.25rem;
    left: 0.25rem;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--md-primary);
    transition: left var(--ms) var(--ease);
  }
  [data-on] .sd-dot {
    left: calc(100% - 2.25rem);
  }
  .sd-dot.effects {
    left: auto;
    right: 0.25rem;
    background: var(--md-outline-variant);
    transition: background-color var(--ms) var(--ease);
  }
  [data-on] .sd-dot.effects {
    left: auto;
    background: var(--md-tertiary);
  }
  @media (max-width: 40rem) {
    .sd-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
